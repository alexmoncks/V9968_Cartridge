module vdp_color_palette_ram (
  clk85m,
  w_palette_valid,
  ff_display_color_oe,
  w_palette_r,
  w_palette_g,
  w_palette_b,
  w_palette_num,
  ff_display_color,
  w_display_r16,
  w_display_g16,
  w_display_b16
)
;
input clk85m;
input w_palette_valid;
input ff_display_color_oe;
input [4:0] w_palette_r;
input [4:0] w_palette_g;
input [4:0] w_palette_b;
input [7:0] w_palette_num;
input [7:0] ff_display_color;
output [4:0] w_display_r16;
output [4:0] w_display_g16;
output [4:0] w_display_b16;
wire [31:15] DO;
wire VCC;
wire GND;
  SDPB ram_r_ram_r_0_0_s (
    .DO({DO[31:15],w_display_b16[4:0],w_display_g16[4:0],w_display_r16[4:0]}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,w_palette_b[4:0],w_palette_g[4:0],w_palette_r[4:0]}),
    .BLKSELA({GND,GND,GND}),
    .BLKSELB({GND,GND,GND}),
    .ADA({GND,GND,w_palette_num[7:0],GND,GND,VCC,VCC}),
    .ADB({GND,GND,ff_display_color[7:0],GND,GND,GND,GND}),
    .CLKA(clk85m),
    .CLKB(clk85m),
    .CEA(w_palette_valid),
    .CEB(ff_display_color_oe),
    .OCE(GND),
    .RESETA(GND),
    .RESETB(GND) 
);
defparam ram_r_ram_r_0_0_s.BIT_WIDTH_0=16;
defparam ram_r_ram_r_0_0_s.BIT_WIDTH_1=16;
defparam ram_r_ram_r_0_0_s.READ_MODE=1'b0;
defparam ram_r_ram_r_0_0_s.RESET_MODE="SYNC";
defparam ram_r_ram_r_0_0_s.BLK_SEL_0=3'b000;
defparam ram_r_ram_r_0_0_s.BLK_SEL_1=3'b000;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* vdp_color_palette_ram */
