    .ff_reset_n2(ff_reset_n2),
    .w_bus_address(w_bus_address[2:0]),
    .ff_wr(ff_wr),
    .n6_6(n6_6),
    .w_red(w_red[5]),
    .w_green(w_green[5:4]),
    .w_blue(w_blue[5])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* tangnano20k_vdp_cartridge */
