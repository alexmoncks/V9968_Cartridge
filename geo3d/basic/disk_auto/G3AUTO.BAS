10 ' geo3d BASIC ROM: run by AUTOEXEC.BAS at boot (run_tests.sh, auto): the first
20 ' CLEAR comes with a file open; the work area waits for one without
30 F=FRE(0):OUT &H2F,F-INT(F/256)*256:OUT &H2F,INT(F/256):OUT &H2E,230
40 ON ERROR GOTO 9000:IF PEEK(&H2D)=3 THEN SCREEN 5
50 E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,232
55 ' CLEAR n,m above the work area with a file open: BASIC closes it after H.CLEA
60 H=PEEK(&HFC4A)+256*PEEK(&HFC4B):OPEN "G3T.DAT" FOR OUTPUT AS #1:PRINT #1,"G3OK":CLEAR 200,H+500:ON ERROR GOTO 9000:A$=STRING$(150,"Z"):OUT &H2E,233
70 E=0:CALL G3OBJ(1,0):OUT &H2F,E:OPEN "G3T.DAT" FOR INPUT AS #1:INPUT #1,A$:CLOSE #1:OUT &H2F,LEN(A$):OUT &H2F,ASC(A$):OUT &H2E,234
80 CLEAR 200:ON ERROR GOTO 9000:E=0:CALL G3OBJ(2,0):OUT &H2F,E:OUT &H2E,235
90 E=0:CALL G3END:OUT &H2F,E:SCREEN 0:PRINT "AUTO OK":OUT &H2E,231
100 OUT &H2E,199:END
9000 E=ERR:EL=ERL:OUT &H2F,ERR:OUT &H2F,ERL AND 255:OUT &H2F,ERL\256:OUT &H2E,250:RESUME NEXT
