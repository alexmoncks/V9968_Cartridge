10 ' geo3d BASIC ROM skeleton checks, run by run_tests.sh (tests.tcl)
20 ' OUT &H2F,v: data for the next check. OUT &H2E,n: check point n
30 ON ERROR GOTO 9000:GOSUB 9100
40 IF P=&H98 THEN SCREEN 0
50 OUT &H2E,10
100 ' ---- before any G3INIT
110 E=0:CALL G3FOO:OUT &H2F,E:OUT &H2E,11
120 E=0:CALL G3OBJ(1,1):OUT &H2F,E:OUT &H2E,12
130 E=0:CALL XYZ:OUT &H2F,E:OUT &H2E,13
140 E=0:CALL G3END:OUT &H2F,E:OUT &H2E,14
150 IF P=&H98 THEN E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,15
160 IF MV>0 THEN E=0:CALL MEMINI:OUT &H2F,E:OUT &H2E,16
200 ' ---- argument errors (98h: in SCREEN 5)
210 IF P=&H98 THEN SCREEN 5
220 E=0:CALL G3INIT(6):OUT &H2F,E:OUT &H2E,20
230 E=0:CALL G3INIT(7):OUT &H2F,E:OUT &H2E,21
240 E=0:CALL G3INIT(8):OUT &H2F,E:OUT &H2E,22
250 E=0:CALL G3INIT(,&H90):OUT &H2F,E:OUT &H2E,23
260 E=0:CALL G3INIT("A"):OUT &H2F,E:OUT &H2E,24
270 E=0:CALL G3INIT(1E6):OUT &H2F,E:OUT &H2E,25
280 E=0:CALL G3INIT(-40000!):OUT &H2F,E:OUT &H2E,26
290 E=0:CALL G3INIT(5.5):OUT &H2F,E:OUT &H2E,27
300 E=0:CALL G3INIT(5,Q):OUT &H2F,E:OUT &H2E,28
310 E=0:CALL G3INIT(5:OUT &H2F,E:OUT &H2E,29
320 E=0:CALL G3INIT(5,P,1):OUT &H2F,E:OUT &H2E,30
330 E=0:CALL G3INIT(5)X:OUT &H2F,E:OUT &H2E,31
340 E=0:A$="5":CALL G3INIT(A$):OUT &H2F,E:OUT &H2E,32
350 E=0:CALL G3INIT(&H88):OUT &H2F,E:OUT &H2E,33
400 ' ---- the first G3INIT: everything is checked
410 OUT &H2E,40
420 E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,41
430 OUT P+5,&H40:FOR I=0 TO 8:OUT &H2F,INP(P+7):NEXT:OUT &H2F,INP(P+5):OUT &H2E,42
440 T=TIME
450 IF TIME-T<60 THEN 450
460 OUT &H2E,43
470 ' ---- waits: timeout and CTRL+STOP (tests.tcl makes geo3d or CE look busy)
475 OUT &H2E,44
480 E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,45
485 ON STOP GOSUB 9200:STOP ON:OUT &H2E,46
490 E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,47
492 OUT &H2E,63
494 E=0:CALL G3INIT:OUT &H2F,E:STOP OFF:OUT &H2E,64
496 OUT &H2E,65
498 E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,66
500 ' ---- probes: a VDP mirrored at P+5, a busy geo3d
502 OUT &H2E,34
504 E=0:CALL G3INIT(5,P):OUT &H2F,E:OUT &H2E,35
506 OUT &H2E,36
508 E=0:CALL G3INIT(5,P):OUT &H2F,E:OUT &H2E,37
510 ' ---- other forms of G3INIT (check point 48 undoes what G3INIT sets)
515 OUT &H2E,49
520 E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,50
525 OUT &H2F,1:OUT &H2E,48:E=0:_G3INIT:OUT &H2F,E:OUT &H2E,51
530 OUT &H2F,2:OUT &H2E,48:E=0:CALL G3INIT(5,P):OUT &H2F,E:OUT &H2E,52
540 OUT &H2F,3:OUT &H2E,48:E=0:CALL G3INIT(,P):OUT &H2F,E:OUT &H2E,53
550 OUT &H2F,0:OUT &H2E,48:E=0:CALL G3INIT ( 5 , P ):OUT &H2F,E:OUT &H2E,54
560 OUT &H2F,0:OUT &H2E,48:E=0:X!=4.6:CALL G3INIT(X!):OUT &H2F,E:OUT &H2E,55
570 OUT &H2F,0:OUT &H2E,48:E=0:X#=5:X%=P:CALL G3INIT(X#,X%):OUT &H2F,E:OUT &H2E,56
580 OUT &H2F,0:OUT &H2E,48:E=0:CALL G3INIT(5.4999,P+.4):OUT &H2F,E:OUT &H2E,57
590 IF P=&H98 THEN SCREEN 5:OUT &H2E,58
600 ' ---- the trampoline in the work area (USR routine written by tests.tcl)
610 DIM M%(40):A=VARPTR(M%(0)):OUT &H2F,A AND 255:OUT &H2F,(A AND &HFF00)/256 AND 255:OUT &H2E,60
620 DEFUSR=A:E=0:R=USR(1234.7):OUT &H2F,E:OUT &H2F,R AND 255:OUT &H2F,(R AND &HFF00)/256 AND 255:OUT &H2E,61
630 E=0:R=USR(40000!):OUT &H2F,E:OUT &H2E,62
700 ' ---- G3END
710 OUT &H2E,70
720 E=0:CALL G3END:OUT &H2F,E:OUT &H2E,71
730 E=0:CALL G3END:OUT &H2F,E:OUT &H2E,72
740 E=0:CALL G3END(1):OUT &H2F,E:OUT &H2E,73
750 SCREEN 0:PRINT "G3END OK":OUT &H2E,74
800 ' ---- G3INIT again, other screens, CLEAR
805 IF P=&H88 THEN OUT &H2F,0:OUT &H2E,48
810 E=0:CALL G3INIT(5):OUT &H2F,E:OUT &H2E,80
820 IF P=&H98 THEN SCREEN 5:OUT &H2F,0:OUT &H2E,48:E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,81
830 IF P=&H98 THEN SCREEN 0:PRINT "TEXT IN V9968 MODE":OUT &H2E,82
840 IF P=&H88 AND MV>0 THEN SCREEN 5:OUT &H2F,0:OUT &H2E,48:E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,83
850 IF P=&H88 AND MV>0 THEN SCREEN 8:E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,84
860 IF P=&H88 AND MV>0 THEN OUT &H2F,0:OUT &H2E,48:E=0:CALL G3INIT(5):OUT &H2F,E:OUT &H2E,85
870 SCREEN 0
880 H=PEEK(&HFC4A)+256*PEEK(&HFC4B):CLEAR 300,H+100:GOSUB 9100:OUT &H2E,88
890 IF P=&H98 THEN SCREEN 5
900 OUT &H2F,0:OUT &H2E,48:E=0:CALL G3INIT(5):OUT &H2F,E:OUT &H2E,89
910 ' ---- a CLEAR that leaves no room for the work area gives it to BASIC
920 H=PEEK(&HFC4A)+256*PEEK(&HFC4B):V=PEEK(&HF6C2)+256*PEEK(&HF6C3):CLEAR H-V-500,H+2048:GOSUB 9100:OUT &H2E,91
930 E=0:CALL G3END:OUT &H2F,E:OUT &H2E,92
940 H=PEEK(&HFC4A)+256*PEEK(&HFC4B)-2048:CLEAR 300,H:GOSUB 9100:OUT &H2E,93
950 OUT &H2F,0:OUT &H2E,48:E=0:CALL G3INIT(5):OUT &H2F,E:OUT &H2E,94
960 E=0:CALL G3END:OUT &H2F,E:OUT &H2E,90
970 SCREEN 0:OUT &H2E,99:END
9000 E=ERR:OUT &H2F,ERR:OUT &H2F,ERL AND 255:OUT &H2F,ERL\256:OUT &H2E,250:RESUME NEXT
9100 ON ERROR GOTO 9000:MV=PEEK(&H2D):IF MV=3 THEN P=&H98 ELSE P=&H88
9110 A=0:E=0:R=0:I=0:T=0:H=0:Q=&H120-P:RETURN
9200 RETURN
