10 ' G held at boot: nothing installed, G3 names are Syntax errors
20 ON ERROR GOTO 90
30 E=0:MV=PEEK(&H2D):IF MV=3 THEN SCREEN 5
40 E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,110
50 E=0:CALL G3END:OUT &H2F,E:OUT &H2E,111
60 SCREEN 0:OUT &H2E,199:END
90 E=ERR:OUT &H2F,ERR:OUT &H2F,ERL AND 255:OUT &H2F,ERL\256:OUT &H2E,250:RESUME NEXT
