10 ' second RUN: G3INIT and G3END again, then a G3INIT left on (tests.tcl
15 ' resets the machine and runs G3RESET.BAS)
20 ON ERROR GOTO 90
30 E=0:MV=PEEK(&H2D):IF MV=3 THEN P=&H98:SCREEN 5 ELSE P=&H88
40 OUT &H2F,0:OUT &H2E,48:E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,100
50 E=0:CALL G3END:OUT &H2F,E:OUT &H2E,101
60 SCREEN 0:PRINT "SECOND RUN OK":OUT &H2E,102
70 COLOR 15,4,7:IF P=&H98 THEN SCREEN 5
80 E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,103:END
90 E=ERR:OUT &H2F,ERR:OUT &H2F,ERL AND 255:OUT &H2F,ERL\256:OUT &H2E,250:RESUME NEXT
