10 ' after a reset with a G3INIT left on: the work area of the last boot is
15 ' still in RAM, signed, and must not count
20 ON ERROR GOTO 900
30 MV=PEEK(&H2D):IF MV=3 THEN P=&H98 ELSE P=&H88
40 COLOR 15,1,2:IF P=&H98 THEN SCREEN 5
50 OUT &H2E,120
60 E=0:CALL G3END:OUT &H2F,E:OUT &H2E,121
70 E=0:CALL G3INIT:OUT &H2F,E:OUT &H2E,122
80 E=0:CALL G3END:OUT &H2F,E:OUT &H2E,123
90 SCREEN 0:PRINT "RESET RUN OK":OUT &H2E,199:END
900 E=ERR:OUT &H2F,ERR:OUT &H2F,ERL AND 255:OUT &H2F,ERL\256:OUT &H2E,250:RESUME NEXT
