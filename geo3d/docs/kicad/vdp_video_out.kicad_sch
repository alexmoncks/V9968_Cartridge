(text "REG 16 · LUT 9 · ALU 10 · DSP 2" (exclude_from_sim no) (at 220.98 116.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bc8c8eaa-dd40-4c6d-805b-e87c608a3027"))
(text_box "Lógica local de vdp_video_out: 20 assign, 9 always (registradores)\n  assign w_interlace = reg_interlace_mode | reg_flat_interlace_mode\n  assign display_hs = ff_hs\n  assign display_vs = ff_vs\n  assign w_next_numerator = { 1'b0, ff_numerator } + c_numerator\n  assign w_sub_numerator = w_next_numerator - { 1'b0, reg_denominator }\n  assign w_enable = h_count[0]\n  assign w_hold = w_sub_numerator[8]\n  assign w_x_position_w = h_count[11:2]\n  assign w_is_write_odd = v_count[0]\n  assign w_normalized_numerator = ff_numerator * reg_normalize\n  assign w_scanline_gain = { 2'd0, w_bilinear_r } + { 2'd0, w_bilinear_g } + { 2'd0, w_bilinear_b } + { 10'd128 }\n  assign w_gain = (has_scanline == 1'b0 ) ? 8'd128: (w_interlace ) ? ( (v_count[0] == ~field) ? 8'd128: 8'd0 ): (v_count[0] ==...\n  assign w_display_r = ff_bilinear_r * ff_gain\n  assign w_display_g = ff_bilinear_g * ff_gain\n  assign w_display_b = ff_bilinear_b * ff_gain\n  assign w_display_en = ff_h_en & ff_v_en\n  assign display_r = w_display_en ? ff_display_r : 8'd0\n  assign display_g = w_display_en ? ff_display_g : 8'd0\n  assign display_b = w_display_en ? ff_display_b : 8'd0\n  assign display_en = w_display_en" (exclude_from_sim no) (at 20.32 134.62 0) (size 258.42 40.64) (stroke (width 0.1524) (type solid)) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "72980453-d832-47d4-a14a-26c763f6b9c5"))
(text_box "Convenções\n• Portas lógicas com bolinha = entrada ou saída invertida.\n• Flip-flops sensíveis à borda de subida; R/S = reset/set SÍNCRONO\n  (feito dentro do always @(posedge clk)), ativo em 0 quando há bolinha.\n• EN = habilitação do clock (o registrador mantém o valor quando EN inativo).\n• Um registrador [n:0] é desenhado como um flip-flop: são n+1 em paralelo.\n• Rótulos iguais na mesma folha = mesmo sinal. Rótulos com * são nomes\n  criados para o desenho (no RTL são expressões sem nome).\n• Bandeiras (hierarchical labels) = portas do módulo, ligadas à folha-mãe." (exclude_from_sim no) (at 20.32 180.34 0) (size 165.1 26.67) (stroke (width 0.1524) (type solid)) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "efb6b407-a12d-4575-b30a-f759bbf4d82b"))
