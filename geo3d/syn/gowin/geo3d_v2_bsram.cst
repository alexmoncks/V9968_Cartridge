// geo3d v2.0 with 1024-entry RAMs (AW = 10) on the Tang Nano 20K: where its
// 21 block RAMs go. Appended to the copy's constraints by build_v2.sh
// (CST=...); HRA!'s file is not changed and none of his instances is named.
//
// Left to itself, the placer spreads geo3d's RAMs over the three BSRAM rows
// and HRA!'s sprite divide table moves from BSRAM_R46[9] (where his own
// build has it) to the far end of row R28: the sprite logic follows it, away
// from the screen position counter it reads, and his worst clk85m path
// fails by 0.8 to 1.3 ns. With geo3d's RAMs kept in row R10 and at the left
// end of row R46, the whole of row R28 (his line buffers and palette, with
// the sprite logic around them) and the rest of R46 stay his, as in his
// build. Two other arrangements were tried (the six RAMs of the last lines
// at the left end of R28, or split between R28 and R46): they leave his
// worst path with -0.04 and +0.06 ns; this one, with +0.38 ns (Route Option
// 2; docs/geo3d_v2.md has the table).
INS_LOC "u_geo3d/u_engine/vmem_vmem_0_0_s" BSRAM_R10[0];
INS_LOC "u_geo3d/u_engine/vmem_vmem_0_1_s" BSRAM_R10[1];
INS_LOC "u_geo3d/u_engine/vmem_vmem_0_2_s" BSRAM_R10[2];
INS_LOC "u_geo3d/u_engine/pmem_pmem_0_0_s" BSRAM_R10[3];
INS_LOC "u_geo3d/u_engine/pmem_pmem_0_1_s" BSRAM_R10[4];
INS_LOC "u_geo3d/u_engine/pmem_pmem_0_2_s" BSRAM_R10[5];
INS_LOC "u_geo3d/u_engine/fmem_fmem_0_0_s" BSRAM_R10[6];
INS_LOC "u_geo3d/u_engine/fmem_fmem_0_1_s" BSRAM_R10[7];
INS_LOC "u_geo3d/u_engine/fmem_fmem_0_2_s" BSRAM_R10[8];
INS_LOC "u_geo3d/u_engine/fmem_fmem_0_3_s" BSRAM_R10[9];
INS_LOC "u_geo3d/u_engine/fmem_fmem_0_4_s" BSRAM_R10[10];
INS_LOC "u_geo3d/u_engine/fmem_fmem_0_5_s" BSRAM_R10[11];
INS_LOC "u_geo3d/u_engine/smem_smem_0_0_s" BSRAM_R10[12];
INS_LOC "u_geo3d/u_engine/smem_smem_0_1_s" BSRAM_R10[13];
INS_LOC "u_geo3d/u_engine/smem_smem_0_2_s" BSRAM_R10[14];
INS_LOC "u_geo3d/u_engine/tmem_tmem_0_0_s" BSRAM_R46[0];
INS_LOC "u_geo3d/u_engine/tmem_tmem_0_1_s" BSRAM_R46[1];
INS_LOC "u_geo3d/u_engine/tmem_tmem_0_2_s" BSRAM_R46[2];
INS_LOC "u_geo3d/u_engine/tmem_tmem_0_3_s" BSRAM_R46[3];
INS_LOC "u_geo3d/u_engine/emem_emem_0_0_s" BSRAM_R46[4];
INS_LOC "u_geo3d/u_engine/emem_emem_0_1_s" BSRAM_R46[5];
